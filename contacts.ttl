@prefix contacts: <https://github.com/afrigeri/skohub-pages/contact/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

contactpos: a skos:ConceptScheme ;
    skos:prefLabel "Geologic contact positional certainty"@en .
    dct:title "Contact Vocabulary"@en, "Vocabolario dei contatti"@it ;
    dct:creator "Alessandro Frigeri"@it ;
    dct:created "2021-11-02"^^xsd:date ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    skos:hasTopConcept contact:certain, contact:approximate .

contactpos:certain a skos:Concept ;
    skos:prefLabel "certain"@en ;
    skos:definition "The position of the contact is confidently located."@en ;
    skos:inScheme contactpos: .

contactpos:approximate
    a skos:Concept ;
    skos:prefLabel "approximate"@en ;
    skos:definition "The position of the contact is approximately located."@en ;
    skos:inScheme contactpos: .

contactpos:inferred
    a skos:Concept ;
    skos:prefLabel "inferred"@en ;
    skos:definition "The position of the contact is inferred from indirect geological evidence."@en ;
    skos:inScheme contactpos: .
