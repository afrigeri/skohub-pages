@prefix contactpos: <https://afrigeri.github.io/skohub-pages/contact/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

contactpos:
    a skos:ConceptScheme ;
    skos:prefLabel "Geologic contact positional certainty"@en ;
    dct:title "Contact Vocabulary"@en ,
              "Vocabolario dei contatti"@it ;
    dct:creator "Alessandro Frigeri" ;
    dct:created "2026-08-25"^^xsd:date ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    skos:hasTopConcept
        contactpos:certain ,
        contactpos:approximate ,
        contactpos:inferred .

contactpos:certain
    a skos:Concept ;
    skos:prefLabel "certain"@en ;
    skos:definition
        "The position of the contact is confidently located."@en ;
    skos:topConceptOf contactpos: ;
    skos:inScheme contactpos: .

contactpos:approximate
    a skos:Concept ;
    skos:prefLabel "approximate"@en ;
    skos:definition
        "The position of the contact is approximately located."@en ;
    skos:topConceptOf contactpos: ;
    skos:inScheme contactpos: .

contactpos:inferred
    a skos:Concept ;
    skos:prefLabel "inferred"@en ;
    skos:definition
        "The position of the contact is inferred from indirect geological evidence."@en ;
    skos:topConceptOf contactpos: ;
    skos:inScheme contactpos: .