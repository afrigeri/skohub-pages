@prefix sym: <https://afrigeri.github.io/skohub-pages/symbol/> .
@prefix contact: <https://afrigeri.github.io/skohub-pages/contact/> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Concept Scheme
#################################################################

sym:
    a skos:ConceptScheme ;

    dct:title
        "Geologic Map Symbols"@en ,
        "Simboli per la cartografia geologica"@it ;

    skos:prefLabel
        "Geologic map symbols"@en ,
        "Simboli cartografici geologici"@it ;

    skos:definition
        "Controlled vocabulary describing cartographic symbols used for the portrayal of geologic features."@en ,
        "Vocabolario controllato che descrive i simboli cartografici utilizzati per la rappresentazione delle feature geologiche."@it ;

    dct:creator "Alessandro Frigeri" ;

    dct:created "2026-08-25"^^xsd:date ;

    dct:license
        <https://creativecommons.org/publicdomain/zero/1.0/> ;

    skos:hasTopConcept
        sym:contact-certain ,
        sym:contact-approximate ,
        sym:contact-inferred .


#################################################################
# Certain contact
#################################################################

sym:contact-certain
    a skos:Concept ;

    skos:prefLabel
        "certain contact symbol"@en ,
        "simbolo di contatto certo"@it ;

    skos:altLabel
        "solid contact line"@en ,
        "continuous contact line"@en ;

    skos:definition
        "Cartographic symbol used to portray a geologic contact whose mapped position is considered certain."@en ,
        "Simbolo cartografico utilizzato per rappresentare un contatto geologico la cui posizione cartografata è considerata certa."@it ;

    skos:scopeNote
        "Normally rendered as a continuous line. Line width, colour and other graphic parameters depend on the adopted portrayal specification."@en ,
        "Normalmente rappresentato mediante una linea continua. Spessore, colore e altri parametri grafici dipendono dalla specifica di rappresentazione adottata."@it ;

    skos:notation "contact-certain" ;

    skos:related contact:certain ;

    skos:inScheme sym: ;
    skos:topConceptOf sym: .


#################################################################
# Approximate contact
#################################################################

sym:contact-approximate
    a skos:Concept ;

    skos:prefLabel
        "approximate contact symbol"@en ,
        "simbolo di contatto approssimato"@it ;

    skos:altLabel
        "dashed contact line"@en ;

    skos:definition
        "Cartographic symbol used to portray a geologic contact whose mapped position is approximately located."@en ,
        "Simbolo cartografico utilizzato per rappresentare un contatto geologico la cui posizione cartografata è determinata approssimativamente."@it ;

    skos:scopeNote
        "Normally rendered as a dashed line. Dash length, spacing, line width and colour depend on the adopted portrayal specification."@en ,
        "Normalmente rappresentato mediante una linea tratteggiata. Lunghezza dei tratti, spaziatura, spessore e colore dipendono dalla specifica di rappresentazione adottata."@it ;

    skos:notation "contact-approximate" ;

    skos:related contact:approximate ;

    skos:inScheme sym: ;
    skos:topConceptOf sym: .


#################################################################
# Inferred contact
#################################################################

sym:contact-inferred
    a skos:Concept ;

    skos:prefLabel
        "inferred contact symbol"@en ,
        "simbolo di contatto inferito"@it ;

    skos:altLabel
        "inferred contact line"@en ,
        "interpreted contact line"@en ;

    skos:definition
        "Cartographic symbol used to portray an inferred geologic contact."@en ,
        "Simbolo cartografico utilizzato per rappresentare un contatto geologico inferito."@it ;

    skos:scopeNote
        "Normally rendered as a dotted or short-dashed line according to the adopted cartographic convention."@en ,
        "Normalmente rappresentato mediante una linea puntinata o a tratteggio corto secondo la convenzione cartografica adottata."@it ;

    skos:notation "contact-inferred" ;

    skos:related contact:inferred ;

    skos:inScheme sym: ;
    skos:topConceptOf sym: .
